      "@id": "kt:aws-outposts",
      "@type": "kto:Service",
      "skos:prefLabel": "AWS Outposts",
      "skos:definition": "AWS Outposts is a fully managed service that installs AWS-owned racks or servers at a customer's own site and runs them as an extension of an Availability Zone in a parent Region, so the same EC2, EBS, VPC and other APIs can serve workloads that need on-premises latency, local processing or data residency.",
      "kto:domain": "global-infrastructure",
