    {
      "@id": "kt:amazon-s3-files",
      "@type": "kto:Feature",
      "skos:prefLabel": "Amazon S3 Files",
      "skos:definition": "An Amazon S3 capability, generally available since 2026-04, that exposes a general purpose S3 bucket (or prefix) as a shared NFS v4.1/4.2 file system for EC2, Lambda, ECS and EKS. Built on Amazon EFS, it caches the active working set on low-latency storage and keeps the file system and bucket synchronized in both directions, so the data never leaves S3.",
      "kto:domain": "storage",
