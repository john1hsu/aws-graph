      "@id": "kt:cloud-computing",
      "@type": "kto:Concept",
      "skos:prefLabel": "Cloud computing",
      "skos:definition": "A model for on-demand, network-based access to a shared, elastic pool of metered computing resources that are provisioned and released with minimal provider interaction; NIST defines it by five essential characteristics, three service models (IaaS, PaaS, SaaS) and four deployment models.",
      "kto:domain": "global-infrastructure",
