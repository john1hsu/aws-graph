      "@id": "kt:multi-region-architecture",
      "@type": "kto:Pattern",
      "skos:prefLabel": "Multi-Region architecture",
      "skos:definition": "An architecture pattern in which a workload is deployed in two or more AWS Regions, with replicated data and Region-independent components, to bound recovery from a Regional impairment, meet data residency needs or serve users with lower latency; AWS recommends it only when a Multi-AZ design in one Region cannot meet the requirement.",
      "kto:domain": "architecture-practice",
