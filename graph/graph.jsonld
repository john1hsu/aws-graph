    {
      "@id": "kt:local-zones",
      "@type": "kto:InfrastructureConcept",
      "skos:prefLabel": "AWS Local Zones",
      "skos:definition": "AWS Local Zones are extensions of an AWS Region placed in or near large metro areas, running a core subset of services such as EC2, EBS, VPC subnets and Application Load Balancer so latency-sensitive parts of a workload can sit close to users while the rest stays in the parent Region.",
      "kto:domain": "global-infrastructure",
