      "@id": "kt:aws-pricing-fundamentals",
      "@type": "kto:Concept",
      "skos:prefLabel": "AWS pricing fundamentals",
      "skos:definition": "The core principles behind how AWS bills: pay-as-you-go for what you consume, lower rates in exchange for a usage commitment, lower per-unit rates at higher volume, and three main cost drivers (compute, storage and outbound data transfer).",
      "kto:domain": "cost-management",
      "dcterms:created": "2026-11-13",
      "kto:verifiedOn": "2026-11-13",
      "kto:status": "concept",
