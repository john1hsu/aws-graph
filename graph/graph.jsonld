    {
      "@id": "kt:shuffle-sharding",
      "@type": "kto:Pattern",
      "skos:prefLabel": "Shuffle sharding",
      "skos:definition": "A fault-isolation pattern in which each customer or resource is assigned its own pseudo-random combination of workers (a virtual \"shuffle shard\") instead of one fixed shard, so a poison-pill request or flood aimed at one customer degrades only its combination while other customers keep at least some healthy workers.",
      "kto:domain": "architecture-practice",
      "dcterms:created": "2026-11-18",
      "kto:verifiedOn": "2026-11-18",
      "kto:status": "concept",
      "prov:wasDerivedFrom": [
