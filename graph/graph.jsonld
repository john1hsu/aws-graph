    {
      "@id": "kt:data-residency-on-aws",
      "@type": "kto:Concept",
      "skos:prefLabel": "Data residency on AWS",
      "skos:definition": "How customers keep content stored and processed in a chosen geography on AWS: they pick the Regions, AWS commits not to move content out of them without agreement, and customers enforce the boundary with Region-restricting policies, AWS Control Tower data residency controls and, where no local Region exists, AWS Outposts or Local Zones.",
      "kto:domain": "public-sector-and-compliance",
      "dcterms:created": "2026-11-15",
      "kto:verifiedOn": "2026-11-15",
      "kto:status": "concept",
