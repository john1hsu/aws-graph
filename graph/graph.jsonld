      "@id": "kt:cell-based-architecture",
      "@type": "kto:Pattern",
      "skos:prefLabel": "Cell-based architecture",
      "skos:definition": "A resilience pattern that splits a workload into multiple isolated, identical, fixed-size copies called cells, each serving a subset of customers chosen by a partition key behind a thin cell router, so that a failure, bad deployment or poison-pill request is contained to one cell rather than the whole fleet.",
      "kto:domain": "architecture-practice",
      "dcterms:created": "2026-11-16",
      "kto:verifiedOn": "2026-11-16",
      "kto:status": "concept",
