    {
      "@id": "kt:cmmc-on-aws",
      "@type": "kto:ComplianceProgram",
      "skos:prefLabel": "CMMC on AWS",
      "skos:definition": "How U.S. defense contractors meet the DoD's Cybersecurity Maturity Model Certification (CMMC) on AWS: CMMC certifies the contractor, not the cloud, so contractors build their CUI environment in AWS GovCloud (US) or the US East/West Regions on FedRAMP-authorized services and inherit part of the NIST SP 800-171 controls through AWS's CMMC Customer Package.",
      "kto:domain": "public-sector-and-compliance",
      "dcterms:created": "2026-11-19",
