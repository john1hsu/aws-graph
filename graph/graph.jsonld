    {
      "@id": "kt:dod-cloud-computing-srg-impact-levels",
      "@type": "kto:ComplianceProgram",
      "skos:prefLabel": "DoD Cloud Computing SRG impact levels",
      "skos:definition": "The U.S. Department of Defense scheme, run by DISA, that grades cloud offerings by the sensitivity of DoD data they may hold (IL2, IL4, IL5, IL6); on AWS, the US East/West Regions hold IL2, AWS GovCloud (US) holds IL2, IL4 and IL5, and the AWS Secret Region holds IL6, scoped per service.",
      "kto:domain": "public-sector-and-compliance",
      "dcterms:created": "2026-11-10",
