    {
      "@id": "kt:security-groups-vs-network-acls",
      "@type": "kto:Concept",
      "skos:prefLabel": "Security groups vs network ACLs",
      "skos:definition": "The two built-in traffic filters of an Amazon VPC: security groups are stateful, allow-only firewalls attached to resources, while network ACLs are stateless, ordered allow/deny rule lists attached to subnets. AWS treats security groups as the primary control and network ACLs as an optional, coarse-grained second layer.",
      "kto:domain": "networking-and-content-delivery",
      "dcterms:created": "2026-11-19",
      "kto:verifiedOn": "2026-11-19",
      "kto:status": "concept",
