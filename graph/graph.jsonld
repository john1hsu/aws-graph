    {
      "@id": "kt:aws-regions",
      "@type": "kto:InfrastructureConcept",
      "skos:prefLabel": "AWS Regions",
      "skos:definition": "A Region is a separate geographic area where AWS clusters data centers into at least three isolated Availability Zones; Regions are independent fault-isolation boundaries, belong to one partition, and newer (opt-in) Regions must be enabled per account before use.",
      "kto:domain": "global-infrastructure",
      "dcterms:created": "2026-11-08",
      "kto:verifiedOn": "2026-11-08",
      "kto:status": "concept",
