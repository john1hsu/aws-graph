    {
      "@id": "kt:ci-cd",
      "@type": "kto:Concept",
      "skos:prefLabel": "Continuous integration and continuous delivery",
      "skos:definition": "The DevOps practice of merging small code changes frequently into a shared main branch with automated builds and tests (CI), then automatically promoting every validated change through test environments so it is always ready for production (continuous delivery) or released to production with no manual gate (continuous deployment).",
      "kto:domain": "devops-and-iac",
      "dcterms:created": "2026-11-13",
      "kto:verifiedOn": "2026-11-13",
      "kto:status": "concept",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "What is continuous integration and continuous delivery/deployment? - Practicing Continuous Integration and Continuous Delivery on AWS",
          "dcterms:publisher": "Amazon Web Services",
          "schema:url": "https://docs.aws.amazon.com/whitepapers/latest/practicing-continuous-integration-continuous-delivery/what-is-continuous-integration-and-continuous-deliverydeployment.html",
          "kto:sourceType": "official-docs"
        },
        {
          "dcterms:title": "Understanding CI/CD - AWS Prescriptive Guidance (The CI/CD litmus test)",
          "dcterms:publisher": "Amazon Web Services",
          "schema:url": "https://docs.aws.amazon.com/prescriptive-guidance/latest/strategy-cicd-litmus/understanding-cicd.html",
          "kto:sourceType": "official-docs"
        },
        {
          "dcterms:title": "Indicators for continuous integration - DevOps Guidance",
          "dcterms:publisher": "Amazon Web Services",
          "schema:url": "https://docs.aws.amazon.com/wellarchitected/latest/devops-guidance/indicators-for-ci.html",
          "kto:sourceType": "official-docs"
        },
        {
