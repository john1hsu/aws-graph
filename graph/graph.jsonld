      "@id": "kt:shared-responsibility-model",
      "@type": "kto:Concept",
      "skos:prefLabel": "AWS shared responsibility model",
      "skos:definition": "The AWS shared responsibility model divides security and compliance duties between AWS, which secures the cloud itself (facilities, hardware, network, host OS and virtualization), and the customer, who secures what they run in it; the customer's share shrinks as services become more managed.",
      "kto:domain": "global-infrastructure",
      "dcterms:created": "2026-11-13",
      "kto:verifiedOn": "2026-11-13",
      "kto:status": "concept",
