    {
      "@id": "kt:aws-secret-and-top-secret-regions",
      "@type": "kto:InfrastructureConcept",
      "skos:prefLabel": "AWS Secret and Top Secret Regions",
      "skos:definition": "AWS's physically and network-isolated Regions for U.S. classified workloads: two Secret-level Regions (Secret, 2017, and Secret-West, 2025), authorized at DoD SRG IL6 and ICD 503, and two Top Secret Regions (Top Secret-East, 2014, and Top Secret-West, 2021) for the intelligence, defense and national security communities.",
