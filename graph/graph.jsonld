    {
      "@id": "kt:static-stability",
      "@type": "kto:Pattern",
      "skos:prefLabel": "Static stability",
      "skos:definition": "A resilience pattern in which a workload keeps running in the same mode during a failure as in normal operation, because capacity, configuration and resources are provisioned in advance and recovery relies on the data plane rather than on control plane actions such as launching instances or editing DNS records.",
      "kto:domain": "architecture-practice",
      "dcterms:created": "2026-11-17",
      "kto:verifiedOn": "2026-11-17",
      "kto:status": "concept",
      "prov:wasDerivedFrom": [
