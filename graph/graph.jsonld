    {
      "@id": "kt:lambda-cold-starts",
      "@type": "kto:Concept",
      "skos:prefLabel": "Lambda cold starts",
      "skos:definition": "The extra latency, and billed time, an AWS Lambda invocation incurs when Lambda must create and initialize a new execution environment (download code, start the runtime and extensions, run static init code) before the handler runs; mitigated by lean initialization, SnapStart and provisioned concurrency.",
      "kto:domain": "serverless-and-integration",
      "dcterms:created": "2026-11-15",
      "kto:verifiedOn": "2026-11-15",
      "kto:status": "concept",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Understanding the Lambda execution environment lifecycle - AWS Lambda",
          "dcterms:publisher": "Amazon Web Services",
          "schema:url": "https://docs.aws.amazon.com/lambda/latest/operatorguide/static-initialization.html",
          "kto:sourceType": "official-docs"
        },
        {
