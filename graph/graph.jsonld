    {
      "@id": "kt:efs-quotas",
      "@type": "kto:Limit",
      "skos:prefLabel": "Amazon EFS quotas",
      "skos:definition": "The limits that constrain Amazon EFS: a few adjustable account and performance quotas (1,000 file systems per Region, Elastic throughput and IOPS ceilings), many fixed ones (25,000 connections, one mount target per AZ, one VPC per file system), per-NFS-client caps such as 1,500 MiBps and 65,536 open files, and file-level limits such as a 47.9 TiB maximum file size.",
      "kto:domain": "storage",
